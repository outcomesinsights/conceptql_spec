# Copy to .env.  Points prep_readme.sh at the test_data service in this
# repository's docker-compose.yml (docker compose up -d --wait test_data).
SEQUELIZER_URL=postgres://ryan:r@127.0.0.1:55432/test_data
SEQUELIZER_SEARCH_PATH=slim,gdm_vocabs
# ConceptQL connects to LEXICON_URL when it loads, and falls back to SQLite
# (not in this bundle) when it is unset.  The vocabulary tables it then uses are
# the ones on the search path above, so the same database serves.
LEXICON_URL=postgres://ryan:r@127.0.0.1:55432/test_data
